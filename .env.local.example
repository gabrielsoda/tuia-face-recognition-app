APP_NAME=Facial Recognition TP1
MODEL_NAME=face_detection.pth
SIMILARITY_METRIC=cosine
SIMILARITY_THRESHOLD=0.2231
EMBEDDINGS_PATH=data/embeddings.json
DATA_PATH=data
OUTPUT_PATH=output
# Orígenes permitidos para CORS (coma). Use * en desarrollo.
CORS_ORIGINS="http://localhost:8080"
MODEL_PATH=models
MODEL_NAME=face_detection.pth
# Detector de rostros (opcional). Archivo .pth/.onnx dentro de MODEL_PATH;
# dejarlo vacío si el detector no necesita archivo (p. ej. viene de una librería).
DETECTOR_MODEL_NAME=
# Score mínimo de detección y tamaño de entrada del detector
DET_SCORE_THRESHOLD=0.5
DET_INPUT_SIZE=640
# Lado mínimo (px) de la caja para aceptar un rostro
MIN_FACE_SIZE=20
# Margen relativo alrededor de la caja al recortar para buscar landmarks
ALIGN_MARGIN=0.5
MAX_WORKERS=2
FACE_SIZE=112
# Must match your face embedding model (InsightFace ArcFace is usually 512).
EMBEDDING_DIM=512

# PostgreSQL / pgvector (future integration)
USE_PGVECTOR=true
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=faces
POSTGRES_USER=faces_user    
POSTGRES_PASSWORD=faces_pass
